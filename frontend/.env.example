# The base URL of the FastAPI backend (must end with /api).
# Local `npm run dev` ignores this (Vite proxies same-origin /api -> :8000).
# Deployed frontend (Vercel) MUST set this to the Render/backend origin,
# e.g. VITE_API_BASE_URL=https://netraksha-api.onrender.com/api
VITE_API_BASE_URL=http://localhost:8000/api

# Canonical origin of the deployed site (custom domain). Drives canonical
# tags, Open Graph URLs and the generated sitemap.xml / robots.txt / llms.txt.
# On Vercel: Project Settings → Domains → add your domain, then set this to it.
VITE_SITE_URL=https://netraksha.xyz
