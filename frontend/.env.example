# The base URL of the FastAPI backend
VITE_API_BASE_URL=http://localhost:8000/api

# Canonical origin of the deployed site (custom domain). Drives canonical
# tags, Open Graph URLs and the generated sitemap.xml / robots.txt / llms.txt.
# On Vercel: Project Settings → Domains → add your domain, then set this to it.
VITE_SITE_URL=https://sih-weld-psi.vercel.app
