# Backend / System Configuration
# Optional: Provide a Gemini API key for AI-based screening fallback
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash
# Optional: Set a custom evidence directory (defaults to samples/evidence)
SCREEN_EVIDENCE_DIR=

# Authentication
# IMPORTANT: Change this in production
JWT_SECRET=sih-hackathon-dev-secret-change-in-prod
JWT_EXPIRY_HOURS=8

# Database Config 
# Leave DATABASE_URL empty to use local sqlite db (screening.db)
# Example PostgreSQL URL: postgresql+asyncpg://user:password@localhost/dbname
DATABASE_URL=
DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
