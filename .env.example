# Backend / System Configuration
# Optional: Provide a Gemini API key for AI-based screening fallback.
# Must be a valid Google AI key (starts with "AIza" — get one at
# https://aistudio.google.com/apikey). A missing/invalid key forces every
# screening into offline simulation: "DEMO ONLY" + "CLOUD UNAVAILABLE" banners
# and a Yellow floor. Unknown model names fail the same way.
GEMINI_API_KEY=your_gemini_api_key_here
# Ordered comma-separated list of Gemini models to try (newest → stable fallback).
# The scanner tries each model in turn; if one fails (overloaded, not found, quota
# exceeded) it moves to the next before falling back to offline simulation.
# Default cascade when unset: gemini-3.7-flash → gemini-3.6-flash → gemini-1.5-flash
GEMINI_MODELS=gemini-3.7-flash,gemini-3.6-flash,gemini-1.5-flash
# Legacy: GEMINI_MODEL is still respected (used as the primary, then appended with
# the default cascade). GEMINI_MODELS takes priority when both are set.
# GEMINI_MODEL=gemini-3.6-flash
# Optional: Set a custom evidence directory (defaults to samples/evidence).
# On Render/Railway mount a persistent disk here — ephemeral disks wipe
# evidence PNGs on every restart.
SCREEN_EVIDENCE_DIR=
# Extra browser origins allowed to call /api (comma-separated). The stock
# localhost/Vercel/Netraksha origins are always allowed; add your deploy
# domains here, e.g. "https://app.example.com,https://api.example.com".
CORS_ORIGINS=

# Authentication
# Deployment environment: development | staging | production.
# production FAILS STARTUP on default/weak secrets and never creates demo
# credentials — set every value below before promoting.
APP_ENV=development
# IMPORTANT: >= 32 random chars in production (enforced at startup).
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=sih-hackathon-dev-secret-change-in-prod
JWT_EXPIRY_HOURS=8
# Minutes a supervisor MFA step-up token stays valid.
MFA_TOKEN_MINUTES=5
# Login / MFA-code brute-force throttles (attempts per window).
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
MFA_RATE_LIMIT_MAX_ATTEMPTS=5
MFA_RATE_LIMIT_WINDOW_SECONDS=300
# Production bootstrap: the ONLY account created when APP_ENV=production
# (supervisor role, forced password rotation at first login). Never commit
# real values here — inject via your host's secret manager.
BOOTSTRAP_ADMIN_USER=
BOOTSTRAP_ADMIN_PASS=
BOOTSTRAP_ADMIN_UNIT=HQ

# Master-registry authority imports (controlled enrollment)
# Dedicated HMAC secret for signing authority import batches. If empty, the
# backend falls back to JWT_SECRET (startup logs a warning). Set a distinct
# long random value in production and share it with the issuing authority
# ONLY over a secure channel. Sign batches with scripts/sign_registry_import.py.
REGISTRY_IMPORT_SECRET=change-me-to-a-long-random-authority-secret

# Database Config — Supabase PostgreSQL is REQUIRED in production
# (APP_ENV=production fails fast without it; non-prod falls back to a local
# SQLite file for offline dev). `postgresql://` is auto-rewritten to
# `postgresql+asyncpg://` by backend/database.py.
# Supabase Transaction pooler URL (REQUIRED on Render), port 6543, e.g.:
# postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Copy it from Supabase Dashboard → Project Settings → Database → Connection string.
DATABASE_URL=
DB_ECHO=false
# Free-tier pooler is small — render.yaml pins 2/5; keep 5/10 only for larger DBs.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# Registry photos — Supabase Storage (production layout)
# Store citizens_registry.photo_uri as a STORAGE PATH, e.g. "img/aadhaar_2345.png"
# (bucket "img" + object key). Never store expiring signed URLs in the DB.
# The backend resolves the path server-side and feeds the bytes to both the
# local InsightFace 3-way matcher and Gemini Image 3 — browsers never see keys.
# Get values from Supabase Dashboard → Project Settings → Data API / API Keys.
SUPABASE_URL=
# Server-only. Required for PRIVATE bucket reads (signed-URL + object GET).
# NEVER put this in Vercel/frontend env or commit it. Render backend only.
SUPABASE_SERVICE_ROLE_KEY=
# Fallback for PUBLIC buckets only. Not sufficient for private "img" reads.
SUPABASE_ANON_KEY=
# Must match the Storage bucket name you create (default "img").
SUPABASE_PHOTOS_BUCKET=img
# Signed-URL TTL seconds for private reads (15–600, default 60).
SUPABASE_PHOTO_SIGNED_TTL=60
